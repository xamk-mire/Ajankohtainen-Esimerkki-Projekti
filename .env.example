# Copy to `.env` and adjust locally. Never commit `.env`.
#
# API reads these into `backend/app/core/config.py` at startup.
# What actually affects behavior today vs later:
#   API_HOST / API_PORT  — loaded now; local Uvicorn still uses the CLI flags
#   CORS_ORIGINS         — loaded now; CORS allowlist for the Vite origin (S1-11)
#   POSTGRES_*           — Compose `db` service (S1-07); not queried by /health
#   DATABASE_URL         — local Uvicorn uses localhost here; Compose overrides
#                          the api service so the hostname is `db` (not localhost).

POSTGRES_USER=tracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=exercise_tracker

# SQLAlchemy 2 + psycopg3 driver URL for local Uvicorn (published port 5432).
# docker-compose.yml overrides this inside the api container (host `db`).
DATABASE_URL=postgresql+psycopg://tracker:changeme@localhost:5432/exercise_tracker

API_HOST=0.0.0.0
API_PORT=8000

# Vite dev origin (comma-separated if you add more). Used for CORS in S1-11.
CORS_ORIGINS=http://localhost:5173
