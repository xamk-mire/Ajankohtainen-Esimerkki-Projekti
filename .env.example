# Copy to `.env` and adjust locally. Never commit `.env`.
#
# API reads these into `backend/app/core/config.py` at startup.
# What actually affects behavior today vs later:
#   API_HOST / API_PORT  — loaded now; local Uvicorn still uses the CLI flags
#   CORS_ORIGINS         — SPA allowlist (exact origins, no *). Default is
#                          http://localhost:5173 — not 127.0.0.1, not the
#                          Compose service name `web`.
#   SQLADMIN_*           — SQLAdmin at /admin only; a JWT will not open it
#   JWT_SECRET / ACCESS_TOKEN_EXPIRE_MINUTES — app-user JWT (Register/Login UI);
#                          SQLAdmin credentials will not call /auth/me
#   POSTGRES_*           — Compose `db` service (S1-07); not queried by /health
#   DATABASE_URL         — local Uvicorn uses localhost here; Compose overrides
#                          the api service so the hostname is `db` (not localhost).

POSTGRES_USER=tracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=exercise_tracker

# SQLAlchemy 2 + psycopg3 driver URL for local Uvicorn (published port 5432).
# docker-compose.yml overrides this inside the api container (host `db`).
DATABASE_URL=postgresql+psycopg://tracker:changeme@localhost:5432/exercise_tracker

API_HOST=0.0.0.0
API_PORT=8000

# Browser origin of the Vite UI (comma-separated if you add more). Exact match:
# http://localhost:5173 is not http://127.0.0.1:5173. Do not use *.
CORS_ORIGINS=http://localhost:5173

# SQLAdmin at /admin — separate from JWT app-user login. A JWT will not open
# /admin. Default admin/admin is for local learning only; change on shared machines.
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=admin
SQLADMIN_SECRET_KEY=change-me-sqladmin-secret

# App-user JWT (not SQLAdmin). Generate a real secret, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real .env.
JWT_SECRET=change-me-jwt-secret-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
